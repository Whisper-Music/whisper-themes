#WMT 1
# Пример темы Whisper Music: цвета, фон, превью и немного CSS. Описание формата — docs/WMT-FORMAT.md

@@ manifest
{
  "id": "night-sky",
  "name": "Ночное небо",
  "author": "Whisper Music",
  "description": "Синий акцент и звёздный фон — пример темы",
  "base": "neon",
  "preview": "asset:preview.png"
}

@@ tokens
{
  "color": {
    "accent": "#6fb7ff",
    "accent2": "#2a62c9",
    "text": "#e6f1ff",
    "muted": "#8ea6c8"
  },
  "effects": {
    "glow": 30,
    "panelOpacity": 0.6,
    "dim": 0.2
  },
  "background": {
    "image": "asset:bg.jpg"
  }
}

@@ css whisper-music
.head h2 { font-family: var(--font-display); letter-spacing: .06em; }
.side .nav { border-radius: 4px; }
@media (max-width: 900px) { .side .nav { border-radius: 0; } }

